# Terraform working directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Terraform plans
*.tfplan

# Variable files that could contain secrets
*.tfvars
*.tfvars.json

# Terraform crash files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform backup files
*.backup

# VS Code local configuration
.vscode/